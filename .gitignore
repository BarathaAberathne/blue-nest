# ── TypeScript incremental build cache ───────────────────────────────────────
*.tsbuildinfo

# ── Lighthouse / Playwright artefacts ─────────────────────────────────────────
# Keep REPORT.md (committed documentation), drop the JSON+HTML report runs.
frontend/lighthouse-reports/*
!frontend/lighthouse-reports/REPORT.md
frontend/.lighthouseci/
frontend/test-results/
frontend/playwright-report/

# ── Build / runtime artefacts ────────────────────────────────────────────────
backend/main
frontend/main
# Keep the uploads dir trackable. Seed product images under
# backend/uploads/products/ ARE committed (the Dockerfile bakes them into the
# image so a fresh deploy has product imagery to show). Admin-uploaded runtime
# files in production live in the docker `uploads_data` volume, not in git.
# In dev mode, new uploads appear in `git status` — review before committing.

# ── Working-doc audit markdowns (untracked working notes, not docs to ship) ──
/ARCHITECTURE_SUMMARY.md
/FIXES_REQUIRED.md
/FRONTEND_OPTIMIZATION_RESULTS.md
/PRODUCTION_READINESS_AUDIT.md
/PRODUCTION_TEST_RESULTS.md
/blue-nest-all-branch-fee-calculator-data.xlsx

# ── Claude working files ──────────────────────────────────────────────────────
.claude/

# Real Famly exports — contain children/staff PII, never commit
famly-templates/
*famly-templates*.zip
backend/seedfamly
