# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Go ────────────────────────────────────────────────────────────────────────
backend/bin/
*.exe
*.test
*.out

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/.turbo/
.npm

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Editor ────────────────────────────────────────────────────────────────────
.idea/
.vscode/settings.json
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Coverage ──────────────────────────────────────────────────────────────────
coverage/
*.coverage

# ── TypeScript incremental build cache ───────────────────────────────────────
*.tsbuildinfo

# ── Lighthouse / Playwright artefacts ─────────────────────────────────────────
# Keep REPORT.md (committed documentation), drop the JSON+HTML report runs.
frontend/lighthouse-reports/*
!frontend/lighthouse-reports/REPORT.md
frontend/.lighthouseci/
frontend/test-results/
frontend/playwright-report/

# ── Build / runtime artefacts ────────────────────────────────────────────────
backend/main
frontend/main
# Keep the uploads dir trackable (via .gitkeep) so docker build works on a
# clean checkout, but never commit the runtime uploaded files themselves.
backend/uploads/*
!backend/uploads/.gitkeep

# ── Working-doc audit markdowns (untracked working notes, not docs to ship) ──
/ARCHITECTURE_SUMMARY.md
/FIXES_REQUIRED.md
/FRONTEND_OPTIMIZATION_RESULTS.md
/PRODUCTION_READINESS_AUDIT.md
/PRODUCTION_TEST_RESULTS.md
/blue-nest-all-branch-fee-calculator-data.xlsx

# ── Claude working files ──────────────────────────────────────────────────────
.claude/
