# =============================================================================
# This file is the LOCAL DEVELOPMENT template. For production on the droplet,
# copy `.env.production.example` instead. See `deployment-instructions.md`.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_SECRET=change-me-to-a-random-32-char-secret

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=blue_nest_montessori

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-jwt-secret
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_SITE_URL=https://bluenest.uk

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated; add LAN IP for device testing: http://localhost:3000,http://192.168.1.39:3000
FRONTEND_URL=http://localhost:3000

# ── SMTP (email) ─────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to skip sending emails in local dev (form still saves to DB).
# For production use SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<SG key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bluenest.uk
SMTP_ADMIN_TO=ba@bluenest.com

# ── Default users (seeded by `make seed-users`) ───────────────────────────────
# Both blocks are optional. Leave a block blank to skip seeding that user.
# Re-running the seed is idempotent: existing users keep their passwords;
# only the role is corrected if it drifted.
DEFAULT_ADMIN_EMAIL=admin@bluenest.uk
DEFAULT_ADMIN_PASSWORD=changeme-min-8-chars
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=User

DEFAULT_CUSTOMER_EMAIL=
DEFAULT_CUSTOMER_PASSWORD=
DEFAULT_CUSTOMER_FIRST_NAME=Test
DEFAULT_CUSTOMER_LAST_NAME=Customer

# ── Validation tuning ────────────────────────────────────────────────────────
# When a user registers, the API does a DNS MX/A lookup on their email's domain
# to reject fake TLDs like `.ccc` and typos like `gmial.com`. Set to `false` to
# disable (useful for CI runners with no DNS, or air-gapped dev). The check
# always skips reserved test TLDs (.test, .example, .invalid, .localhost) and
# fails open on transient DNS errors — it only rejects definite NXDOMAIN.
EMAIL_DNS_CHECK=true
