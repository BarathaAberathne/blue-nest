# =============================================================================
# Blue Nest Montessori — LOCAL STAGING .env template
# =============================================================================
#
# Copy to .env.staging (gitignored) and fill in. This drives the local
# prod-image QA gate:  cp .env.staging.example .env.staging  &&  make staging-up
#
# It mirrors the production key surface (.env.production.example) so the staging
# run exercises the same config the live site needs — but with localhost URLs
# and TEST credentials. `make staging-up` runs scripts/check-env.sh against this
# file first, so any missing required key blocks the run (just like prod).

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8080
APP_SECRET=staging_app_secret_change_me_32chars

# ── Container images ──────────────────────────────────────────────────────────
# Empty prefix → images are BUILT locally by the staging overlay (not pulled).
IMAGE_PREFIX=
IMAGE_TAG=staging-local
PULL_POLICY=missing

# ── MongoDB (local test creds — not real prod secrets) ────────────────────────
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=staging_root_pw_change_me
MONGO_APP_USERNAME=bluenest_app
MONGO_APP_PASSWORD=staging_app_pw_change_me
MONGODB_DATABASE=blue_nest_montessori

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=staging_jwt_secret_change_me_to_64_hex_chars_for_realistic_parity
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ── Frontend (localhost, so the browser hits the local backend) ───────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ── CORS ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── AI chat assistant (Anthropic) — REQUIRED ─────────────────────────────────
# Put a REAL key here so the chat actually responds during staging QA; this is
# the check that would have caught the prod 503. Defaults model to haiku.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CHAT_MODEL=claude-haiku-4-5-20251001

# ── Stripe (TEST keys for staging) ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ── Email (use a Resend test key, or leave SMTP_* for a local catcher) ────────
RESEND_API_KEY=re_test_REPLACE_ME
SMTP_FROM=noreply@localhost
SMTP_ADMIN_TO=staging@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Default users ──────────────────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@localhost
DEFAULT_ADMIN_PASSWORD=staging_admin_pw_change_me
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=User
DEFAULT_CUSTOMER_EMAIL=
DEFAULT_CUSTOMER_PASSWORD=
DEFAULT_CUSTOMER_FIRST_NAME=
DEFAULT_CUSTOMER_LAST_NAME=

# ── Social login (optional — leave blank for staging) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=

# ── Validation tuning ───────────────────────────────────────────────────────────
EMAIL_DNS_CHECK=true
