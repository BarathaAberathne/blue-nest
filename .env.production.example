# =============================================================================
# Blue Nest Montessori — production .env template
# =============================================================================
#
# Copy this file to .env on the droplet and fill in every value. Never commit
# the populated .env. The file is read by `docker compose -f docker-compose.yml
# -f docker-compose.prod.yml ...`.
#
# Generate strong secrets locally before pasting them in:
#   openssl rand -hex 16     # 32-char APP_SECRET
#   openssl rand -hex 32     # 64-char JWT_SECRET
#   openssl rand -hex 24     # 48-char MONGO_*_PASSWORD
#
# After editing this file: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8080
APP_SECRET=REPLACE_WITH_32_CHAR_RANDOM_HEX

# ── Compose file selection (PRODUCTION SAFETY — required) ─────────────────────
# Docker Compose reads COMPOSE_FILE from this .env, so it pins EVERY `docker
# compose ...` run from this directory (including `make docker-*`) to base + the
# prod overlay. Without it, a bare `docker compose up` would start the dev/base
# config, which publishes MongoDB on 0.0.0.0:27017 with auth disabled.
# Path separator is ':' on Linux. scripts/check-env.sh enforces this on prod.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ── Container images ────────────────────────────────────────────────────────
# Set IMAGE_PREFIX to the GHCR namespace your CI pushes to (lower-case GitHub
# username or org). The CI workflow pushes `blue-nest-frontend` and
# `blue-nest-backend` inside this namespace, so the final image names become
# e.g. `ghcr.io/baratha-aberathne/blue-nest-frontend:latest`.
# Leave blank to fall back to building locally on the droplet via
# `docker compose build` (works but uses more CPU/RAM during deploy).
IMAGE_PREFIX=ghcr.io/REPLACE_WITH_GITHUB_OWNER
IMAGE_TAG=latest
PULL_POLICY=missing

# ── MongoDB ──────────────────────────────────────────────────────────────────
# The root user is what the mongo container's entrypoint creates on first
# start. The app user is created by deploy/mongo-init/01-create-app-user.js
# and is what the Go backend connects with.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=REPLACE_WITH_48_CHAR_RANDOM_HEX
MONGO_APP_USERNAME=bluenest_app
MONGO_APP_PASSWORD=REPLACE_WITH_48_CHAR_RANDOM_HEX
MONGODB_DATABASE=blue_nest_montessori

# MONGODB_URI is assembled in docker-compose.prod.yml from MONGO_APP_* — leave
# this commented out unless you're pointing at a fully external mongo (Atlas).
# MONGODB_URI=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ── Stripe ──────────────────────────────────────────────────────────────────
# Use live keys in production. The webhook secret comes from the endpoint you
# register in Stripe Dashboard → Developers → Webhooks pointing at
# https://api.bluenest.uk/webhooks/stripe.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
# Baked into the client bundle at build time. Must match the public origins
# served by nginx, including https://.
NEXT_PUBLIC_API_URL=https://api.bluenest.uk
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
NEXT_PUBLIC_SITE_URL=https://bluenest.uk

# ── AI chat assistant (Anthropic) ────────────────────────────────────────────
# REQUIRED for the floating "Blue Nest Bot". The Next.js route
# frontend/app/api/chat/route.ts returns HTTP 503 ("Chat service temporarily
# unavailable") on EVERY message when ANTHROPIC_API_KEY is unset — which is how
# the assistant silently broke in production. Key: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Optional — defaults to claude-haiku-4-5-20251001 when unset.
CHAT_MODEL=claude-haiku-4-5-20251001

# ── CORS ────────────────────────────────────────────────────────────────────
# The Go API reads this to construct the Access-Control-Allow-Origin header.
# Comma-separate multiple origins; do NOT include a trailing slash.
# MUST list every public origin the browser loads the site from — if it's
# unset/empty the API falls back to http://localhost:3000 and every browser-side
# API call from the live domain is CORS-blocked ("Failed to fetch"). While the
# site is served from the temporary blue-nest.com domain, include it alongside
# the canonical bluenest.uk.
FRONTEND_URL=https://blue-nest.com,https://www.blue-nest.com,https://bluenest.uk,https://www.bluenest.uk

# ── Email ───────────────────────────────────────────────────────────────────
# PRODUCTION SENDS VIA RESEND (HTTPS), NOT SMTP.
# DigitalOcean blocks outbound SMTP (ports 25/465/587), so classic SMTP
# (Gmail/SendGrid/etc.) will simply time out on the droplet — do NOT configure it
# here. Set RESEND_API_KEY and the mailer uses Resend automatically; the SMTP_*
# host/user/pass below are a LOCAL-DEV-ONLY fallback and are IGNORED whenever
# RESEND_API_KEY is set.
#
# Resend requires the FROM domain to be verified in the Resend dashboard
# (SPF/DKIM DNS records) — and the API key must belong to the SAME Resend
# account that owns the verified domain.
RESEND_API_KEY=re_REPLACE_ME
# From address on outgoing mail. With Resend this MUST be on a domain you've
# verified in the Resend dashboard (SPF/DKIM DNS records). Once bluenest.uk is
# verified you can send as info@bluenest.uk.
SMTP_FROM=info@bluenest.uk
# Recipient(s) for enquiry / application / order notifications. Comma-separated
# to fan out to all branch managers (whitespace is trimmed). ba@ is kept here
# temporarily until receipt is confirmed across the manager inboxes — drop it then.
SMTP_ADMIN_TO=manager@bluenest.uk,borehamwood-manager@bluenest.uk,pinner-manager@bluenest.uk,ba@bluenest.uk

# Store-order notification recipients (comma-separated). Both fall back to
# SMTP_ADMIN_TO when unset. The relevant branch-manager copy is resolved per
# order from that branch's contact email (models/branch.go) — not configured here.
#   ORDER_ADMIN_EMAILS — internal administration team
#   ORDER_BA_EMAILS    — the "BA" recipient group
ORDER_ADMIN_EMAILS=admin@bluenest.uk
ORDER_BA_EMAILS=ba@bluenest.uk

# Local-dev SMTP fallback ONLY (e.g. Mailpit/Gmail off-droplet). Leave BLANK in
# production — it's ignored when RESEND_API_KEY is set, and SMTP is blocked on
# the DigitalOcean droplet regardless.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Default users ───────────────────────────────────────────────────────────
# Run `make seed-users` once after first deploy to create the admin login.
# Re-running is idempotent — only the role is corrected if it drifted.
DEFAULT_ADMIN_EMAIL=admin@bluenest.uk
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=User

# Leave blank to skip seeding the customer test user in production.
DEFAULT_CUSTOMER_EMAIL=
DEFAULT_CUSTOMER_PASSWORD=
DEFAULT_CUSTOMER_FIRST_NAME=
DEFAULT_CUSTOMER_LAST_NAME=

# ── Validation tuning ───────────────────────────────────────────────────────
# Keep DNS MX/A checks on in production — they reject fake TLDs and gmial.com
# typos before they hit the database.
EMAIL_DNS_CHECK=true
