# =============================================================================
# Blue Nest Montessori — production .env template
# =============================================================================
#
# Copy this file to .env on the droplet and fill in every value. Never commit
# the populated .env. The file is read by `docker compose -f docker-compose.yml
# -f docker-compose.prod.yml ...`.
#
# Generate strong secrets locally before pasting them in:
#   openssl rand -hex 16     # 32-char APP_SECRET
#   openssl rand -hex 32     # 64-char JWT_SECRET
#   openssl rand -hex 24     # 48-char MONGO_*_PASSWORD
#
# After editing this file: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_PORT=8080
APP_SECRET=REPLACE_WITH_32_CHAR_RANDOM_HEX

# ── Container images ────────────────────────────────────────────────────────
# Set IMAGE_PREFIX to the GHCR namespace your CI pushes to (lower-case GitHub
# username or org). The CI workflow pushes `blue-nest-frontend` and
# `blue-nest-backend` inside this namespace, so the final image names become
# e.g. `ghcr.io/baratha-aberathne/blue-nest-frontend:latest`.
# Leave blank to fall back to building locally on the droplet via
# `docker compose build` (works but uses more CPU/RAM during deploy).
IMAGE_PREFIX=ghcr.io/REPLACE_WITH_GITHUB_OWNER
IMAGE_TAG=latest
PULL_POLICY=missing

# ── MongoDB ──────────────────────────────────────────────────────────────────
# The root user is what the mongo container's entrypoint creates on first
# start. The app user is created by deploy/mongo-init/01-create-app-user.js
# and is what the Go backend connects with.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=REPLACE_WITH_48_CHAR_RANDOM_HEX
MONGO_APP_USERNAME=bluenest_app
MONGO_APP_PASSWORD=REPLACE_WITH_48_CHAR_RANDOM_HEX
MONGODB_DATABASE=blue_nest_montessori

# MONGODB_URI is assembled in docker-compose.prod.yml from MONGO_APP_* — leave
# this commented out unless you're pointing at a fully external mongo (Atlas).
# MONGODB_URI=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ── Stripe ──────────────────────────────────────────────────────────────────
# Use live keys in production. The webhook secret comes from the endpoint you
# register in Stripe Dashboard → Developers → Webhooks pointing at
# https://api.bluenest.uk/webhooks/stripe.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
# Baked into the client bundle at build time. Must match the public origins
# served by nginx, including https://.
NEXT_PUBLIC_API_URL=https://api.bluenest.uk
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
NEXT_PUBLIC_SITE_URL=https://bluenest.uk

# ── CORS ────────────────────────────────────────────────────────────────────
# The Go API reads this to construct the Access-Control-Allow-Origin header.
# Comma-separate multiple origins; do NOT include a trailing slash.
FRONTEND_URL=https://bluenest.uk

# ── SMTP (email) ────────────────────────────────────────────────────────────
# SendGrid recommended (100/day free, easy domain auth). Verify the sender
# domain before going live or enquiries will land in spam.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.REPLACE_ME
SMTP_FROM=noreply@bluenest.uk
SMTP_ADMIN_TO=manager@bluenest.uk

# ── Default users ───────────────────────────────────────────────────────────
# Run `make seed-users` once after first deploy to create the admin login.
# Re-running is idempotent — only the role is corrected if it drifted.
DEFAULT_ADMIN_EMAIL=admin@bluenest.uk
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=User

# Leave blank to skip seeding the customer test user in production.
DEFAULT_CUSTOMER_EMAIL=
DEFAULT_CUSTOMER_PASSWORD=
DEFAULT_CUSTOMER_FIRST_NAME=
DEFAULT_CUSTOMER_LAST_NAME=

# ── Validation tuning ───────────────────────────────────────────────────────
# Keep DNS MX/A checks on in production — they reject fake TLDs and gmial.com
# typos before they hit the database.
EMAIL_DNS_CHECK=true
